# Caro automatically loads this file when it starts. Explicit shell variables win.
# Provider credentials. Set only those used by your YAML model pool.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional network proxy. HTTPX and all LangChain provider clients read these
# automatically. Keep the scheme explicit; socks5 requires the bundled
# httpx[socks] dependency.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# ALL_PROXY=socks5://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1
# OPENAI_PROXY=http://127.0.0.1:7897

# Optional web search (Tavily). Leave empty to keep web_search disabled.
TAVILY_API_KEY=

# Optional Langfuse v4 tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional explicit opt-in for the standalone event adapter.
# CARO_LANGFUSE_ENABLED=true

# Optional Pydantic Settings overrides.
# CARO_APPROVALS__MINIMUM_RISK=critical
# CARO_WORKSPACE__SHELL_ENABLED=false
